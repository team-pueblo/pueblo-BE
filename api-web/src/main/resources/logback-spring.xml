<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="safeMsg" class="com.pueblo.common.security.SensitiveMessageConverter"/>
    <conversionRule conversionWord="safeEx" class="com.pueblo.common.security.SensitiveThrowableConverter"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{40} requestId=%X{requestId:-none} - %safeMsg%n%safeEx</pattern>
        </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
