# Copy this file to .env at the repository root. .env is excluded from Git.
# JWT_TOKEN is the raw UTF-8 HS256 signing secret (minimum 32 bytes).
# Generate a random value with: openssl rand -hex 32
# Paste the output below; never commit the real value.
# The separate mail encryption key is created by scripts/generate-local-auth-keys.sh.

# SMTP is enabled in application-local.yml. Fill in these values before testing delivery.
# SMTP_USERNAME is also the From address: use an email address authorized by the provider.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-address@example.com
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

JWT_TOKEN=


# If your provider requires implicit TLS: SMTP_PORT=465, SMTP_STARTTLS=false, SMTP_SSL=true.
# In .env, single-quote passwords containing $, #, or spaces so Compose treats them literally.
# Never put actual passwords in this example file.

AUTH_FRONTEND_BASE_URL=http://localhost:5173
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# Public catalog read API CORS origins (no credentials required).
CATALOG_ALLOWED_ORIGINS=http://localhost:5173

# Inventory worker opt-in. Generate a separate random secret; do not reuse JWT_TOKEN.
INVENTORY_ENABLED=false
INVENTORY_LISTENER_ENABLED=false
INVENTORY_COMMAND_SECRET=
INVENTORY_EXPIRY_ENABLED=true

# Enable together with INVENTORY_ENABLED and INVENTORY_LISTENER_ENABLED.
ORDER_FLOW_ENABLED=false
ORDER_TERMS_VERSION=purchase-v1

# Order-side payment preparation only. Separate machine credential, never a browser/JWT secret.
ORDER_PAYMENT_PREPARATION_ENABLED=false
ORDER_PAYMENT_SERVICE_TOKEN=
